{
    "project_name": "Poly2Moment",
    "dataset_name": "NewYork",
    "dataset": "topo_polygon_polyline_multiclass",
    "dataset_type1": "polygons",
    "dataset_type2": "polylines",
    "task": "multi-relation",
    "num_classes": 2,
    "data_path": "./data/NewYork",
    "data_file": "/polygon_polyline_topological_relationship_data.pt",
    "save_dir": "./results/",
    "training": true,

    "encoder_type": "poly2moment",
    "fusion": "learned_fusion",
    "sampling_strategy": "fourier",

    "batch_size": 128,
    "lr": 1e-4,
    "wd": 1e-8,
    "dropout": 0.2,
    "d_input": 225,
    "d_hid": 100,
    "d_out": 32,

    "gfm_params": {
        "w_min": 0.1,
        "w_max": 1.0,
        "n_freqs": 10
    },

    "moment_params": {
        "basis_type": "fourier",
        "max_order": 14,
        "moment_norm": "m00_scale"
    },

    "device": "cuda",

    "epochs": 100,

    "patience": 10
}

{
    "project_name": "Poly2Moment",
    "dataset_name": "NewYork",
    "dataset": "NewYork_polygons_polygons_multi_relation",
    "dataset_type1": "polygons",
    "dataset_type2": "polygons",
    "task": "multi-relation",
    "num_classes": 6,
    "data_path": "./data/NewYork",
    "data_file": "/polygon_polygon_topological_relationship_data.pt",
    "save_dir": "./results/",
    "training": true,

    "encoder_type": "poly2moment",
    "fusion": "learned_fusion",

    "batch_size": 128,
    "lr": 1e-4,
    "wd": 1e-8,
    "dropout": 0.2,
    "d_input": 121,
    "d_hid": 100,
    "d_out": 32,

    "gfm_params": {
        "w_min": 0.1,
        "w_max": 1.0,
        "n_freqs": 10
    },

    "moment_params": {
        "basis_type": "monomial",
        "max_order": 10
    },

    "device": "cuda",

    "epochs": 20,

    "patience": 10
}
